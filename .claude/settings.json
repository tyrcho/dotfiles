{
  "env": {
    "EDITOR": "code --wait"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(brew:*)",
      "Bash(docker context:*)",
      "Bash(npm config:*)",
      "Bash(npm info:*)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(npm search:*)",
      "Bash(npm test:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm view:*)",
      "Bash(npm whoami:*)",
      "Bash(npx eslint:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(test:*)",
      "Bash(unset:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(grep:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(touch:*)",
      "Bash(builtin cd:*)",
      "Bash(./*)",
      "Bash($CLAUDE_PLUGIN_ROOT/*)",
      "Read",
      "Write",
      "Edit",
      "Edit(~/.claude/hooks/**)",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/readme-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/compile-check.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-push-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__chrome-devtools__take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/screenshot-filepath-check.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__take_snapshot",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/snapshot-filepath-check.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{id: .session_id, cwd: .cwd, transcript: .transcript_path, event: \"end\", reason: .reason, ts: (now | todate)}' >> ~/.claude/sessions-state.jsonl"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{id: .session_id, cwd: .cwd, transcript: .transcript_path, event: \"start\", source: .source, ts: (now | todate)}' >> ~/.claude/sessions-state.jsonl"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-opus-4-5-migration@claude-code-plugins": false,
    "commit-commands@claude-code-plugins": true,
    "context7@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "security-guidance@claude-code-plugins": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "verbose": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
