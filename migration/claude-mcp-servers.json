{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "snowflake": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "uvx --python 3.12 --python-preference=managed --from git+https://github.com/Snowflake-Labs/mcp mcp-server-snowflake --service-config-file ~/.config/mcp/snowflake-config.yaml --authenticator externalbrowser --transport stdio --user \"$(whoami)@datadoghq.com\""
      ],
      "env": {
        "SNOWFLAKE_ACCOUNT": "sza96462.us-east-1",
        "SNOWFLAKE_DATABASE": "REPORTING"
      }
    },
    "trajectory": {
      "type": "stdio",
