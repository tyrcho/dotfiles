# Privileges sudo alias - Will trigger PrivilegesCLI before running sudo
alias sudo="/Applications/Privileges.app/Contents/MacOS/PrivilegesCLI -a && /usr/bin/sudo"

brew() {
  local priv_commands=("install" "update" "upgrade" "uninstall" "rm" "remove" "cleanup" "reinstall" "doctor" "config")
  # If the command matches and we are not already admin, elevate to admin
  if [[ " ${priv_commands[*]} " == *" $1 "* ]]; then
    # Only try to elevate if we are in an interactive shell
    if [[ -t 1 ]]; then
      if ! /usr/bin/groups | grep -q -E "\b(admin|wheel)\b"; then
         if /Applications/Privileges.app/Contents/MacOS/PrivilegesCLI -a; then
           # Optional: Add a small sleep to ensure the group membership propagates
           sleep 1
         else
           /bin/echo "PrivilegesCLI failed to elevate. Aborting brew command." >&2
           return 1
         fi
      fi
    fi
  fi
  # Run the actual brew command
  command brew "$@"
  return $?
}
