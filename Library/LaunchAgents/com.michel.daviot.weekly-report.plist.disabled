<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.michel.daviot.weekly-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/michel.daviot/dd/michel-daviot-notes/routines/_local-runner/run-scheduled-claude-task.sh</string>
		<string>--name</string>
		<string>weekly-report</string>
		<string>--prompt-file</string>
		<string>/Users/michel.daviot/dd/michel-daviot-notes/routines/weekly-report/prompt.md</string>
		<string>--hours</string>
		<string>18-20</string>
		<string>--weekdays</string>
		<string>5-5</string>
		<string>--success-marker</string>
		<string>--marker-path</string>
		<string>/tmp/weekly-report.success-marker</string>
		<string>--marker-window-hours</string>
		<string>96</string>
		<string>--check-lid</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/weekly-report.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/weekly-report.log</string>
	<key>StartInterval</key>
	<integer>600</integer>
</dict>
</plist>
