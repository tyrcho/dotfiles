# NOTE: This is at the top to ensure that other user or generated settings do
# not affect workspace connections.
# If you'd like to make changes that apply to all workspaces, see the comments
# in 00-common.conf alongside the included files below
Include /Users/michel.daviot/.ssh/workspaces/*

# Classic ECS workspaces resume on connect. Per-workspace settings above can
# select a direct destination or proxy before this fallback is considered.
# Keep this in the same parsing pass: requesting a final pass changes unrelated
# hosts too. Local devcontainers have no remote workspace to resume.
Match host "workspace-*,*.workspace.infra.dog"
    ProxyCommand workspaces resume-if-paused '%n' '%h' '%p'
Match all
## END -- workspaces cli
