Host nas
	HostName 192.168.0.46
	User admin
	IdentityFile ~/.ssh/id_ed25519

Host *
	AddKeysToAgent yes
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	AddressFamily inet
	Compression yes
	ControlMaster auto
	ControlPath /tmp/ssh_mux_%h_%p_%r
	ControlPersist 10m
	ServerAliveInterval 30
