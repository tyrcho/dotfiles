Host nas
	HostName 192.168.0.46
	User admin
	IdentityFile ~/.ssh/id_ed25519

Host github.com gitlab.com
	User git
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	UseKeychain yes

Host *
	AddKeysToAgent yes
	AddressFamily inet
	Compression yes
	ControlMaster auto
	ControlPath /tmp/ssh_mux_%h_%p_%r
	ControlPersist 10m
	ServerAliveInterval 30
